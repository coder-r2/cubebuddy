*.md
*.MD
*.markdown
# ...except the public README (D-053)
!/README.md

# Claude Code local config
.claude/

# Environment files (Firebase config lives in GitHub repository variables for CI)
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
dev-dist/
coverage/
*.tsbuildinfo
.vite/

# Test artifacts
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

